{
  "name": "paseo-plugin-beads",
  "private": true,
  "version": "0.1.0",
  "description": "Paseo plugin: the beads (bd) issue tree of the open workspace, with a board and charts; browse, create and edit issues.",
  "author": "DrStannum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrStannum/paseo-plugin-beads.git"
  },
  "homepage": "https://github.com/DrStannum/paseo-plugin-beads#readme",
  "bugs": {
    "url": "https://github.com/DrStannum/paseo-plugin-beads/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "beads",
    "bd",
    "issues",
    "issue-tracker"
  ],
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "assets/",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "node --test tests/smoke.test.ts tests/smoke-write.test.ts",
    "write": "node --test tests/write.test.ts",
    "test": "npm run typecheck && node --test tests/*.test.ts",
    "shot": "node tests/shot.mjs",
    "shot:charts": "node tests/shot-charts.mjs",
    "shot:writes": "node tests/shot-writes.mjs",
    "shot:board": "node tests/shot-board.mjs",
    "bench": "node tests/bench-large.ts",
    "preview": "node tests/preview.mjs",
    "fixture": "node tests/fixture/build.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
